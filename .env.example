# Server-only origin for the same-origin API rewrite. No MongoDB credentials here.
BACKEND_URL=http://127.0.0.1:4000

# Public backend origin used by Windows exporters. Set for tunnels/cloud deployment.
# The frontend API proxy can keep using the local/private BACKEND_URL above.
PUBLIC_INGESTION_URL=

# Public FRONTEND origin for Open Graph/share previews. Update when the tunnel changes.
# On Vercel, leave unset to use VERCEL_PROJECT_PRODUCTION_URL automatically.
PUBLIC_SITE_URL=
